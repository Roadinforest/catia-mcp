          "type": "array"
        }
      },
      "required": [
        "model_id",
        "start",
        "end"
      ],
      "title": "lineArguments",
      "type": "object"
    }
  },
  {
    "name": "arc",
    "description": "Append decoded WHUCAD arc geometry. Angles are radians; midpoint identifies the intended arc.",
    "inputSchema": {
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "center": {
          "maxItems": 2,
