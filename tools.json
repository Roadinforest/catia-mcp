      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "solArguments",
      "type": "object"
    }
  },
  {
    "name": "line",
    "description": "Append a line to the current loop; no sketch ID is needed.",
    "inputSchema": {
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "start": {
          "maxItems": 2,
