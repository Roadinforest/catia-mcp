      "type": "object"
    }
  },
  {
    "name": "mirror_topo",
    "description": "Begin a mirror selection declaration; mirror provenance is explicit in the following selection tree.",
    "inputSchema": {
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        }
      },
      "required": [
        "model_id"
      ],
      "title": "mirror_topoArguments",
      "type": "object"
    }
  },
  {
    "name": "selection",
    "description": "Parse ordered WHUCAD target trees including advanced selection markers. Replaces current selection.",
    "inputSchema": {
      "$defs": {
        "Selection": {
          "additionalProperties": false,
          "properties": {
            "select_type": {
              "enum": [
                "Wire",
                "Face",
                "Edge",
                "Multiply_Face",
                "Sub_Face"
              ],
              "title": "Select Type",
              "type": "string"
            },
            "body_type": {
              "default": "None",
              "enum": [
                "None",
                "OriginElements",
                "Sketch",
                "Pad",
                "Shaft",
                "Pocket",
                "Add",
                "Remove",
                "Intersect",
                "Shell",
                "Chamfer",
                "EdgeFillet",
                "Mirror",
                "Hole"
              ],
              "title": "Body Type",
              "type": "string"
            },
            "body_no": {
              "default": 0,
              "minimum": 0,
              "title": "Body No",
              "type": "integer"
            },
            "no": {
              "default": 0,
              "minimum": 0,
              "title": "No",
              "type": "integer"
            },
            "operation_list": {
              "items": {
                "$ref": "#/$defs/Selection"
              },
              "title": "Operation List",
              "type": "array"
            },
            "no_shared_included": {
              "items": {
                "$ref": "#/$defs/Selection"
              },
              "title": "No Shared Included",
              "type": "array"
            },
            "all_oriented_included": {
              "additionalProperties": {
                "items": {
                  "$ref": "#/$defs/Selection"
                },
                "type": "array"
              },
              "propertyNames": {
                "enum": [
                  "Limits1",
                  "Limits2"
                ]
              },
              "title": "All Oriented Included",
              "type": "object"
            },
            "all_partially_included": {
              "anyOf": [
                {
                  "items": {
                    "$ref": "#/$defs/Selection"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "All Partially Included"
            }
          },
          "required": [
            "select_type"
          ],
          "title": "Selection",
          "type": "object"
        }
      },
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Selection"
          },
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "model_id",
        "targets"
      ],
      "title": "selectionArguments",
      "type": "object"
    }
  },
  {
