            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "title": "Radius",
          "type": "number"
        },
        "start_angle": {
          "title": "Start Angle",
          "type": "number"
        },
        "end_angle": {
          "title": "End Angle",
          "type": "number"
        },
        "mid_angle": {
          "title": "Mid Angle",
          "type": "number"
        }
