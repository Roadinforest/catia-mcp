                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "title": "X Direction",
              "type": "array"
            },
            "y_direction": {
              "default": [
                0,
                1,
                0
              ],
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "title": "Y Direction",
              "type": "array"
            }
          },
          "title": "SketchFrame",
          "type": "object"
        }
      },
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "length": {
          "title": "Length",
          "type": "number"
        },
        "frame": {
          "$ref": "#/$defs/SketchFrame",
          "default": {
            "origin": [
              0.0,
              0.0,
              0.0
            ],
            "x_direction": [
              1.0,
              0.0,
              0.0
            ],
            "y_direction": [
              0.0,
              1.0,
              0.0
            ]
          }
        },
        "second_length": {
          "default": 0,
          "title": "Second Length",
          "type": "number"
        },
        "operation": {
          "default": "AddFeatureOperation",
          "enum": [
            "AddFeatureOperation",
            "CutFeatureOperation",
            "IntersectFeatureOperation"
          ],
          "title": "Operation",
          "type": "string"
        },
        "first_limit": {
          "default": "OffsetLimit",
          "enum": [
            "OffsetLimit",
            "UpToNextLimit",
            "UpToLastLimit",
            "UpToPlaneLimit",
            "UpToSurfaceLimit",
            "UpThruNextLimit"
          ],
          "title": "First Limit",
          "type": "string"
        },
        "second_limit": {
          "default": "OffsetLimit",
          "enum": [
            "OffsetLimit",
            "UpToNextLimit",
            "UpToLastLimit",
            "UpToPlaneLimit",
            "UpToSurfaceLimit",
            "UpThruNextLimit"
          ],
          "title": "Second Limit",
          "type": "string"
        },
        "reversed": {
          "default": false,
          "title": "Reversed",
          "type": "boolean"
        }
      },
      "required": [
        "model_id",
        "length"
      ],
      "title": "extrudeArguments",
      "type": "object"
    }
  },
