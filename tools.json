[
  {
    "name": "model_state",
    "description": "Bind active blank CATPart, or inspect a previously bound model.",
    "inputSchema": {
      "properties": {
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        }
      },
      "title": "model_stateArguments",
      "type": "object"
    }
  },
  {
    "name": "sol",
    "description": "Start the next ordered sketch loop. Curves use local millimetres.",
